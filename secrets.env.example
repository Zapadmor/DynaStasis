# DynaStasis — modèle de fichier de secrets.
#
# Installation :
#   mkdir -p ~/.config/dynastasie
#   cp secrets.env.example ~/.config/dynastasie/secrets.env
#   chmod 600 ~/.config/dynastasie/secrets.env
#
# Le fichier vit HORS du dépôt. Chemin personnalisable via DYNASTASIS_ENV_FILE.
# Docker Compose le charge via env_file ; en local, src/config.py le lit directement.
# Convention : variable = SECTION_CLE en majuscules.

# ── Intervals.icu (sport) — https://intervals.icu/settings → Developer Settings
INTERVALS_ICU_ATHLETE_ID=i123456
INTERVALS_ICU_API_KEY=

# ── Strava (records personnels) — https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Générés par `python main.py strava-auth` (puis renouvelés automatiquement) :
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# ── Temps d'écran Samsung via ADB WiFi (optionnel — sinon `logos --manual`)
SAMSUNG_ADB_HOST=192.168.1.42
SAMSUNG_ADB_PORT=5555
# Téléphone jumelé (débogage sans fil) et réseau changeant : pas d'IP, découverte mDNS depuis l'hôte
# SAMSUNG_ADB_MDNS=1

# ── Calendrier Google affiché sur le tableau de bord (optionnel)
# Adresse du calendrier : Google Agenda → Paramètres → Intégrer l'agenda
CALENDAR_SRC=
