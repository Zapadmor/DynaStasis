# Réglages Docker Compose : copier vers .env (ignoré par git). Aucun secret ici ;
# les clés d'API vont dans secrets.env (voir secrets.env.example), hors du dépôt.

# UID/GID du conteneur : doivent pouvoir écrire dans ./db et ./data (`id -u`, `id -g`)
# DYNASTASIS_UID=1000
# DYNASTASIS_GID=1000

# Serveurs DNS du conteneur, essayés dans l'ordre (défaut : 8.8.8.8 puis 8.8.4.4).
# Si le réseau change d'un lieu à l'autre (DNS interne différent), listez-les tous :
# DYNASTASIS_DNS=192.168.13.4
# DYNASTASIS_DNS2=192.168.1.1

# Fichier de secrets (facultatif ; défaut : ~/.config/dynastasie/secrets.env)
# DYNASTASIS_ENV_FILE=/chemin/vers/secrets.env

# Cible de l'image : runtime (défaut) ou adb (ajoute adb pour le temps d'écran Android)
# DYNASTASIS_TARGET=adb

# Limites de ressources du conteneur
# DYNASTASIS_MEM_LIMIT=1g
# DYNASTASIS_CPUS=2

# Sources exclues de la synchro du conteneur (bouton de la page Système inclus). À mettre à `logos`
# quand le temps d'écran est synchronisé depuis l'hôte (timer systemd, ADB retrouvé par mDNS).
# DYNASTASIS_SYNC_SKIP=logos
