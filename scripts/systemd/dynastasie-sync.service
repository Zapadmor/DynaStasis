[Unit]
Description=DynaStasie — synchronisation des sources (Intervals.icu, Strava, ADB, finance)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__WORKDIR__
# Une source en échec n'arrête pas les autres ; le code de retour vaut 1 si l'une a échoué.
# Conteneur arrêté : le script sort en 0 (voir scripts/sync_conteneur.sh).
ExecStart=/usr/bin/env bash __WORKDIR__/scripts/sync_conteneur.sh
SyslogIdentifier=dynastasie-sync
StandardOutput=journal
StandardError=journal
# Quatre sources, chacune avec son propre délai (jusqu'à 3 min) + réseau instable après réveil
TimeoutStartSec=900
