[Unit]
Description=DynaStasie — passage de relais du conteneur entre machines (démarrage / extinction)
# Ordre : au démarrage on passe après Docker, le VPN et Syncthing ; à l'extinction systemd inverse
# l'ordre, donc ExecStop s'exécute AVANT l'arrêt de ces services (SSH et Syncthing encore utilisables).
After=network-online.target docker.service syncthing.service __VPN_UNITS__
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=__USER__
WorkingDirectory=__WORKDIR__
# DYNASTASIS_PEER_SSH (cible SSH de l'autre machine) vit ici, jamais dans le repo.
EnvironmentFile=-__HOME__/.config/dynastasie/peer.env
ExecStart=/usr/bin/python3 __WORKDIR__/scripts/handoff.py start
ExecStop=/usr/bin/python3 __WORKDIR__/scripts/handoff.py stop
SyslogIdentifier=dynastasie-handoff
StandardOutput=journal
StandardError=journal
# Démarrage : jusqu'à ~40 s d'attente du pair + ~45 s de synchro ; extinction : arrêt Docker (30 s)
# + scan/synchro (~50 s) + SSH.
TimeoutStartSec=150
TimeoutStopSec=140

[Install]
WantedBy=multi-user.target
